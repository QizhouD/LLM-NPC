# Unity-digital-Human .gitattributes
# Normalize text to LF. Track large binaries with Git LFS.
# https://git-scm.com/docs/gitattributes
# https://git-lfs.com

# -----------------------------------------------------------------------------
# Default: auto-detect text, store LF in the repository
# -----------------------------------------------------------------------------
* text=auto eol=lf

# Windows scripts must keep CRLF or they will not run under cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# -----------------------------------------------------------------------------
# Unity / C# / shader / package text (Force Text YAML — keep mergeable)
# -----------------------------------------------------------------------------
*.cs text eol=lf diff=csharp
*.js text eol=lf
*.boo text eol=lf

*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.raytrace text eol=lf

*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.rsp text eol=lf
*.gitignore text eol=lf
